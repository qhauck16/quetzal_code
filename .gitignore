# Whitelist: code, configs, docs, final figures, and the small tables the code needs.
# All data, caches and the midway symlinks to outputs are excluded.
*
!*/
!*.R
!*.Rmd
!*.py
!*.sh
!*.sbatch
!Snakefile
!*_Snakefile
!*.smk
!*.yaml
!*.yml
!*.md
!.gitignore
!.quetzal_root

# small reference tables read by the code
!inputs/lists/*.csv
!expression/tcga_recount3_urls.txt
!gist/*.tsv
!gist/*.txt
!gist/HRA005970.xlsx
!benchmarking/*.tsv
!benchmarking/*.txt
!leafcutter_analyses/leaf2_clustering/junc_files.txt
!coverage_tracks/pygenome/regions.tsv
!variant_recalling/ylpm1_biallelic/*/samples.tsv

# final figures
!figures/figure*/out/figure*.pdf
!figures/supplementary/out/*.pdf
!figures/supplementary/out/note*/*.pdf
!figures/supplementary/out/tables/*.tsv

# never: old snapshots, unpublished work, licensed data, logs, tool state
figures_pre*/
YLPM1_val/
data/
figures/logs/
**/.snakemake/
**/.Rproj.user/
